# Dealestate Website Environment Variables Example
# Copy to .env.local and populate with your credentials

# Form Submission Service Configuration:
# Option A: Web3Forms access key
# VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Option B: Custom form provider endpoint or Formspree URL
# VITE_FORM_ENDPOINT=https://formspree.io/f/your_form_id_here
