# Dealestate Website Environment Variables Example
# Copy to .env or .env.local and populate with your credentials

# Form Submission Service Configuration:
# Option A: FormSubmit endpoint (default free tier, direct to email)
# NOTE: The recipient must activate the form by confirming FormSubmit's verification email before launch.
# Submissions are not delivered to the mailbox until activation is complete.
VITE_FORM_ENDPOINT=https://formsubmit.co/ajax/codnexa@gmail.com

# Option B: Formspree endpoint URL
# VITE_FORM_ENDPOINT=https://formspree.io/f/your_form_id_here

# Option C: Web3Forms access key
# VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
